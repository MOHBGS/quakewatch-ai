# Frontend. The Location API key is browser-visible: restrict it by map ARN,
# allowed referrer, and map-only actions before deploying.
VITE_API_BASE_URL=
VITE_AWS_REGION=us-east-1
VITE_AMAZON_LOCATION_MAP_NAME=QuakeWatchMap
VITE_AMAZON_LOCATION_API_KEY=
VITE_MAP_PROVIDER=osm

# CDK uses the normal AWS credential chain (AWS SSO/profile, environment, or
# workload identity); never put AWS credentials in this file.
AWS_REGION=us-east-1
